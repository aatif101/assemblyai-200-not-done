{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "transcript_id",
    "text",
    "utterances"
  ],
  "properties": {
    "transcript_id": {
      "type": "string",
      "minLength": 1
    },
    "text": {
      "type": "string"
    },
    "utterances": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "speaker",
          "text"
        ],
        "properties": {
          "speaker": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      }
    }
  }
}
