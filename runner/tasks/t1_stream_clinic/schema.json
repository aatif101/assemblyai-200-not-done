{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "turns"
  ],
  "properties": {
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "speaker",
          "text"
        ],
        "properties": {
          "speaker": {
            "type": [
              "string",
              "integer",
              "null"
            ]
          },
          "text": {
            "type": "string"
          }
        }
      },
      "minItems": 1
    }
  }
}
